{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-updater",
  "description": "Allows the settings window to check, install, and relaunch after signed updates.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart"
  ]
}
